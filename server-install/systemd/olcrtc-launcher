#!/usr/bin/env bash
# olcRTC server launcher (refactor-universal-carrier branch).
#
# Reads /etc/olcrtc/env (already loaded by systemd into the process
# environment via EnvironmentFile=) and translates it into a YAML config
# file consumed by the olcrtc binary.
#
# Recognised environment variables:
#   OLCRTC_CARRIER           required: jitsi | telemost | wbstream
#   OLCRTC_PROVIDER          deprecated alias for OLCRTC_CARRIER
#   OLCRTC_AUTH_TOKEN        optional: provider-specific account/access token.
#                                       For wbstream, joins with this account token instead of guest auth.
#   OLCRTC_ROOM_ID           required: room ID (for jitsi "any" auto-creates a fresh room)
#   OLCRTC_CLIENT_ID         advisory: per-instance client identifier issued by the admin
#                                       UI. Surfaced through the published olcrtc:// URI to
#                                       seed the mobile client's DeviceID.
#   OLCRTC_KEY               required: 64-char hex encryption key
#   OLCRTC_TRANSPORT         optional: datachannel | vp8channel | seichannel | videochannel (default: datachannel)
#   OLCRTC_DNS               optional: DNS resolver (default 8.8.8.8:53)
#   OLCRTC_DEBUG             optional: set to 1 to enable debug verbose logging
#   OLCRTC_JITSI_BRIDGE_MODE optional: auto | colibri-ws | sctp (default auto)
#   OLCRTC_JITSI_SCTP_MAX_MESSAGE_SIZE optional: full Jitsi SCTP bridge frame cap, default legacy 12288.
#   OLCRTC_TRAFFIC_MAX_PAYLOAD optional: cap encrypted transport payload bytes.
#                                       Leave empty for compatibility; try 1188 with SCTP max message 1200 only for diagnostics.
#   OLCRTC_TRAFFIC_MIN_DELAY optional: send pacing min delay, Go duration (e.g. 1ms).
#   OLCRTC_TRAFFIC_MAX_DELAY optional: send pacing max delay, Go duration (e.g. 3ms).
#   OLCRTC_VP8_FPS           optional: VP8 FPS (default 60, only for vp8channel)
#   OLCRTC_VP8_BATCH         optional: VP8 batch size (default 64, only for vp8channel)
#   OLCRTC_SEI_FPS           optional: SEI FPS (default 60)
#   OLCRTC_SEI_BATCH         optional: SEI batch size (default 64)
#   OLCRTC_SEI_FRAG          optional: SEI fragment size (default 900)
#   OLCRTC_SEI_ACK           optional: SEI ack timeout ms (default 2000)
#   OLCRTC_SOCKS_PROXY       optional: SOCKS5 proxy used for signalling traffic.
#                                       Accepted forms:
#                                         host:port
#                                         user:pass@host:port    (RFC 1929)
#                                         socks5://[user:pass@]host:port
#   OLCRTC_WARP_PROXY        optional: WARP SOCKS5 proxy for client tunnel traffic.
#                                       Form: host:port (e.g. 127.0.0.1:40000)
#   OLCRTC_SUB_ENABLED       optional: set to 1 to enable subscription server
#   OLCRTC_SUB_PORT          optional: subscription server port (default 2096)
#   OLCRTC_SUB_DB            optional: subscription DB path (default /var/lib/olcrtc/subscriptions.db)
#   OLCRTC_SUB_API_TOKEN     optional: subscription API token
#   OLCRTC_SUB_PUBLIC_URL    optional: public subscription base URL, e.g. https://your-domain.mooo.com

set -euo pipefail

CONFIG_FILE="./config.yaml"

# Carrier: prefer OLCRTC_CARRIER, fall back to legacy OLCRTC_PROVIDER
carrier="${OLCRTC_CARRIER:-${OLCRTC_PROVIDER:-}}"
# Backward compat: wb_stream -> wbstream, jazz/salutejazz -> jitsi
[ "$carrier" = "wb_stream" ] && carrier="wbstream"
[ "$carrier" = "jazz" ] && carrier="jitsi"
[ "$carrier" = "salutejazz" ] && carrier="jitsi"

if [ "$carrier" = "openflux" ]; then
    echo "Starting openflux exit node for document: ${OLCRTC_ROOM_ID}"
    IPTABLES_BIN=$(command -v iptables || echo "/usr/sbin/iptables")
    local_ip_flag=""
    if [ -n "${OLCRTC_LOCAL_IP:-}" ]; then
        local_ip_flag="--local-ip ${OLCRTC_LOCAL_IP}"
        if [ -x "$IPTABLES_BIN" ] || command -v iptables >/dev/null 2>&1; then
            iptables -C OUTPUT -s "${OLCRTC_LOCAL_IP}" -p tcp --tcp-flags RST RST -j DROP 2>/dev/null || \
            iptables -I OUTPUT 1 -s "${OLCRTC_LOCAL_IP}" -p tcp --tcp-flags RST RST -j DROP 2>/dev/null || true
        fi
    else
        if [ -x "$IPTABLES_BIN" ] || command -v iptables >/dev/null 2>&1; then
            iptables -C OUTPUT -p tcp --tcp-flags RST RST -j DROP 2>/dev/null || \
            iptables -I OUTPUT 1 -p tcp --tcp-flags RST RST -j DROP 2>/dev/null || true
        fi
    fi
    ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
    OPENFLUX_BIN="/usr/local/bin/openflux"

    # Auto-update / auto-download logic for openflux
    CHECK_THROTTLE_FILE="/tmp/.openflux_update_check"
    NEED_CHECK=0
    if [ ! -x "$OPENFLUX_BIN" ] && [ ! -x "/usr/bin/openflux" ] && [ ! -x "./openflux" ]; then
        NEED_CHECK=1
    elif [ "${OLCRTC_OPENFLUX_AUTO_UPDATE:-true}" != "false" ]; then
        if [ ! -f "$CHECK_THROTTLE_FILE" ] || [ $(($(date +%s) - $(stat -c %Y "$CHECK_THROTTLE_FILE" 2>/dev/null || echo 0))) -gt 3600 ]; then
            NEED_CHECK=1
        fi
    fi

    if [ "$NEED_CHECK" -eq 1 ]; then
        touch "$CHECK_THROTTLE_FILE" 2>/dev/null || true
        REMOTE_URL="$(curl -fsSLI -H "User-Agent: olcrtc-launcher" -o /dev/null -w "%{url_effective}" --max-time 4 https://github.com/Oleglog/OpenFlux-Android/releases/latest 2>/dev/null || true)"
        LATEST_TAG="${REMOTE_URL##*/tag/}"
        INSTALLED_TAG=""
        [ -f /etc/olcrtc/openflux.version ] && INSTALLED_TAG="$(cat /etc/olcrtc/openflux.version 2>/dev/null || true)"

        if [ ! -x "$OPENFLUX_BIN" ] || { [ -n "$LATEST_TAG" ] && [ "$LATEST_TAG" != "$REMOTE_URL" ] && [ "$LATEST_TAG" != "$INSTALLED_TAG" ]; }; then
            echo "Checking OpenFlux binary (installed: ${INSTALLED_TAG:-none}, latest: ${LATEST_TAG:-unknown})..."
            TMP_BIN="/tmp/openflux-$$.tmp"
            DL_URL="https://github.com/Oleglog/OpenFlux-Android/releases/latest/download/openflux-linux-${ARCH}"
            if [ -n "$LATEST_TAG" ] && [ "$LATEST_TAG" != "$REMOTE_URL" ]; then
                DL_URL="https://github.com/Oleglog/OpenFlux-Android/releases/download/${LATEST_TAG}/openflux-linux-${ARCH}"
            fi
            if curl -fsSL --retry 2 --retry-delay 2 --max-time 120 "$DL_URL" -o "$TMP_BIN"; then
                if [ "$(head -c 4 "$TMP_BIN" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ]; then
                    install -m 0755 "$TMP_BIN" /usr/local/bin/openflux
                    mkdir -p /etc/olcrtc
                    [ -n "$LATEST_TAG" ] && [ "$LATEST_TAG" != "$REMOTE_URL" ] && echo "$LATEST_TAG" > /etc/olcrtc/openflux.version 2>/dev/null || true
                    echo "openflux binary updated to ${LATEST_TAG:-latest}"
                    OPENFLUX_BIN="/usr/local/bin/openflux"
                else
                    echo "WARNING: Downloaded OpenFlux is not an ELF binary, keeping previous binary" >&2
                fi
                rm -f "$TMP_BIN"
            fi
        fi
    fi

    if [ ! -x "$OPENFLUX_BIN" ]; then
        if [ -x "/usr/bin/openflux" ]; then
            OPENFLUX_BIN="/usr/bin/openflux"
        elif [ -x "./openflux" ]; then
            OPENFLUX_BIN="./openflux"
        else
            echo "ERROR: openflux binary not found and could not be downloaded" >&2
            exit 1
        fi
    fi
    t="${OLCRTC_TRANSPORT:-yandex}"
    if [ "$t" = "auto" ] || [ -z "$t" ]; then
        if [[ "${OLCRTC_ROOM_ID}" == *"mail.ru"* ]]; then
            t="mailru"
        else
            t="yandex"
        fi
    fi
    mode_flag=""
    if [ -n "${OLCRTC_OPENFLUX_MODE:-}" ]; then
        mode_flag="--mode ${OLCRTC_OPENFLUX_MODE}"
    fi
    debug_flag=""
    if [ -n "${OLCRTC_DEBUG:-}" ] && [ "$OLCRTC_DEBUG" != "0" ] && [ "$OLCRTC_DEBUG" != "false" ]; then
        debug_flag="--debug"
    fi
    codec_flag="--codec ${OLCRTC_CODEC:-legacy}"
    key_flag=""
    if [ -n "${OLCRTC_OPENFLUX_KEY:-${OPENFLUX_KEY:-}}" ]; then
        key_flag="--encryption-key ${OLCRTC_OPENFLUX_KEY:-${OPENFLUX_KEY}}"
    fi
    exec "$OPENFLUX_BIN" --exit-node --url "${OLCRTC_ROOM_ID}" --transport "$t" $mode_flag $local_ip_flag $codec_flag $key_flag $debug_flag
fi

if [ -z "$carrier" ] || [ -z "${OLCRTC_ROOM_ID:-}" ] || [ -z "${OLCRTC_KEY:-}" ]; then
    echo "olcrtc-launcher: missing required env (OLCRTC_CARRIER / OLCRTC_ROOM_ID / OLCRTC_KEY)" >&2
    exit 64
fi

room_id="$OLCRTC_ROOM_ID"
transport="${OLCRTC_TRANSPORT:-datachannel}"
dns="${OLCRTC_DNS:-8.8.8.8:53}"
debug="false"
if [ -n "${OLCRTC_DEBUG:-}" ] && [ "$OLCRTC_DEBUG" != "0" ] && [ "$OLCRTC_DEBUG" != "false" ]; then
    debug="true"
fi

# Build YAML
cat > "$CONFIG_FILE" <<EOF
mode: srv
auth:
  provider: ${carrier}
EOF

if [ -n "${OLCRTC_AUTH_TOKEN:-}" ]; then
    cat >> "$CONFIG_FILE" <<EOF
  token: "${OLCRTC_AUTH_TOKEN}"
EOF
fi

cat >> "$CONFIG_FILE" <<EOF
room:
  id: "${room_id}"
crypto:
  key: "${OLCRTC_KEY}"
net:
  transport: ${transport}
  dns: "${dns}"
data: data
debug: ${debug}
ffmpeg: ffmpeg
EOF

# SOCKS proxy
if [ -n "${OLCRTC_SOCKS_PROXY:-}" ]; then
    proxy="$OLCRTC_SOCKS_PROXY"
    proxy="${proxy#socks5://}"
    proxy="${proxy#socks5h://}"

    proxy_user=""
    proxy_pass=""
    if [[ "$proxy" == *"@"* ]]; then
        creds="${proxy%@*}"
        proxy="${proxy##*@}"
        if [[ "$creds" == *":"* ]]; then
            proxy_user="${creds%%:*}"
            proxy_pass="${creds#*:}"
        else
            proxy_user="$creds"
        fi
    fi

    proxy_host="${proxy%:*}"
    proxy_port="${proxy##*:}"

    cat >> "$CONFIG_FILE" <<EOF
socks:
  host: ""
  port: 0
  proxy_addr: "${proxy_host}"
  proxy_port: ${proxy_port}
EOF
    if [ -n "$proxy_user" ]; then
        echo "  proxy_user: \"${proxy_user}\"" >> "$CONFIG_FILE"
    fi
    if [ -n "$proxy_pass" ]; then
        echo "  proxy_pass: \"${proxy_pass}\"" >> "$CONFIG_FILE"
    fi
else
    cat >> "$CONFIG_FILE" <<EOF
socks:
  host: ""
  port: 0
EOF
fi

# WARP proxy
if [ -n "${OLCRTC_WARP_PROXY:-}" ]; then
    warp="$OLCRTC_WARP_PROXY"
    warp_host="${warp%:*}"
    warp_port="${warp##*:}"
    cat >> "$CONFIG_FILE" <<EOF
warp:
  proxy_addr: "${warp_host}"
  proxy_port: ${warp_port}
EOF
else
    cat >> "$CONFIG_FILE" <<EOF
warp:
  proxy_addr: ""
  proxy_port: 0
EOF
fi

# Subscription server
sub_enabled="false"
if [ -n "${OLCRTC_SUB_ENABLED:-}" ] && [ "$OLCRTC_SUB_ENABLED" != "0" ] && [ "$OLCRTC_SUB_ENABLED" != "false" ]; then
    sub_enabled="true"
fi
sub_port="${OLCRTC_SUB_PORT:-2096}"
sub_db="${OLCRTC_SUB_DB:-/var/lib/olcrtc/subscriptions.db}"
sub_token="${OLCRTC_SUB_API_TOKEN:-}"
sub_public_url="${OLCRTC_SUB_PUBLIC_URL:-}"

cat >> "$CONFIG_FILE" <<EOF
subscription:
  enabled: ${sub_enabled}
  port: ${sub_port}
  db_path: "${sub_db}"
  api_token: "${sub_token}"
  public_url: "${sub_public_url}"
EOF

# Optional traffic shaping. This is mostly useful for Jitsi SCTP fallback
# experiments, where smaller smux frames can avoid SCTP fragmentation and
# head-of-line stalls on some public JVB deployments. Empty values keep the
# built-in transport defaults.
if [ -n "${OLCRTC_TRAFFIC_MAX_PAYLOAD:-}" ] || [ -n "${OLCRTC_TRAFFIC_MIN_DELAY:-}" ] || [ -n "${OLCRTC_TRAFFIC_MAX_DELAY:-}" ]; then
    cat >> "$CONFIG_FILE" <<EOF
traffic:
  max_payload_size: ${OLCRTC_TRAFFIC_MAX_PAYLOAD:-0}
  min_delay: "${OLCRTC_TRAFFIC_MIN_DELAY:-}"
  max_delay: "${OLCRTC_TRAFFIC_MAX_DELAY:-}"
EOF
fi

# VP8 options
if [ "$transport" = "vp8channel" ]; then
    vp8_fps="${OLCRTC_VP8_FPS:-60}"
    vp8_batch="${OLCRTC_VP8_BATCH:-64}"
    cat >> "$CONFIG_FILE" <<EOF
vp8:
  fps: ${vp8_fps}
  batch_size: ${vp8_batch}
EOF
fi

# SEI options
if [ "$transport" = "seichannel" ]; then
    sei_fps="${OLCRTC_SEI_FPS:-60}"
    sei_batch="${OLCRTC_SEI_BATCH:-64}"
    sei_frag="${OLCRTC_SEI_FRAG:-900}"
    sei_ack="${OLCRTC_SEI_ACK:-2000}"
    cat >> "$CONFIG_FILE" <<EOF
sei:
  fps: ${sei_fps}
  batch_size: ${sei_batch}
  fragment_size: ${sei_frag}
  ack_timeout_ms: ${sei_ack}
EOF
fi

# Video channel defaults (only if explicitly videochannel, otherwise minimal)
if [ "$transport" = "videochannel" ]; then
    cat >> "$CONFIG_FILE" <<EOF
video:
  width: 1920
  height: 1080
  fps: 30
  bitrate: "2M"
  hw: none
  codec: qrcode
EOF
fi

exec /usr/local/bin/olcrtc "$CONFIG_FILE"
